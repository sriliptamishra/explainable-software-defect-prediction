    "import pandas as pd\n",
    "\n",
    "DATASETS = {\n",
    "    \"jm1\": \"../data/jm1_clean.csv\",\n",
    "    \"kc1\": \"../data/kc1.csv\",\n",
    "    \"pc1\": \"../data/pc1.csv\",\n",
    "    \"cm1\": \"../data/cm1.csv\",\n",
    "}\n",
    "\n",
    "LABEL_CANDIDATES = [\"defects\", \"problems\"]\n",
    "LABEL_MAP = {\"true\": 1, \"false\": 0, \"yes\": 1, \"no\": 0, \"1\": 1, \"0\": 0}\n",
    "\n",
    "\n",
    "def load_dataset(path):\n",
    "    df = pd.read_csv(path)\n",
    "    df.columns = [c.strip() for c in df.columns]\n",
    "\n",
    "    # Junk rows tabhi hatao jab pehli row ka loc 1.1 ho\n",
    "    junk = 0\n",
    "    if float(df.iloc[0, 0]) == 1.1:\n",
    "        df = df.iloc[2:].reset_index(drop=True)\n",
    "        junk = 2\n",
    "\n",
    "    label_col = next(c for c in LABEL_CANDIDATES if c in df.columns)\n",
    "    y = df[label_col].astype(str).str.strip().str.lower().map(LABEL_MAP)\n",
    "    X = df.drop(columns=[label_col]).apply(pd.to_numeric, errors=\"coerce\")\n",
    "\n",
    "    out = X.copy()\n",
    "    out[\"defects\"] = y\n",
    "    return out, junk\n",
    "\n",
    "\n",
    "data, rows = {}, []\n",
    "for name, path in DATASETS.items():\n",
    "    df, junk = load_dataset(path)\n",
    "    data[name] = df\n",
    "    n_def = int(df[\"defects\"].sum())\n",
    "    rows.append({\n",
    "        \"dataset\": name,\n",
    "        \"modules\": len(df),\n",
    "        \"features\": df.shape[1] - 1,\n",
    "        \"defective\": n_def,\n",
    "        \"non_defective\": len(df) - n_def,\n",
    "        \"defect_rate_%\": round(100 * n_def / len(df), 1),\n",
    "        \"missing_values\": int(df.isna().sum().sum()),\n",
    "        \"duplicates\": int(df.duplicated().sum()),\n",
    "        \"junk_rows_removed\": junk,\n",
    "    })\n",
    "\n",
    "pd.DataFrame(rows).set_index(\"dataset\")"
   ]
