    "import os\n",
    "import pandas as pd\n",
    "from sklearn.model_selection import StratifiedKFold, cross_validate\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from xgboost import XGBClassifier\n",
    "from imblearn.pipeline import Pipeline as ImbPipeline\n",
    "from imblearn.over_sampling import SMOTE\n",
    "\n",
    "SCORING = [\"accuracy\", \"precision\", \"recall\", \"f1\"]\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "\n",
    "def make_model(name):\n",
    "    if name == \"RandomForest\":\n",
    "        clf = RandomForestClassifier(n_estimators=200, random_state=42, n_jobs=-1)\n",
    "    else:\n",
    "        clf = XGBClassifier(n_estimators=200, max_depth=4, learning_rate=0.1,\n",
    "                            eval_metric=\"logloss\", random_state=42, n_jobs=-1)\n",
    "    # SMOTE pipeline ke andar hai, isliye sirf training folds pe lagta hai (no leakage)\n",
    "    return ImbPipeline([\n",
    "        (\"impute\", SimpleImputer(strategy=\"median\")),\n",
    "        (\"scale\", MinMaxScaler()),\n",
    "        (\"smote\", SMOTE(random_state=42)),\n",
    "        (\"clf\", clf),\n",
    "    ])\n",
    "\n",
    "\n",
    "results = []\n",
    "for ds_name, df in data.items():\n",
    "    for variant, d in [(\"with_duplicates\", df), (\"no_duplicates\", df.drop_duplicates())]:\n",
    "        X = d.drop(columns=\"defects\")\n",
    "        y = d[\"defects\"].astype(int)\n",
    "        for model_name in [\"RandomForest\", \"XGBoost\"]:\n",
    "            scores = cross_validate(make_model(model_name), X, y, cv=cv, scoring=SCORING)\n",
    "            row = {\"dataset\": ds_name, \"variant\": variant, \"model\": model_name, \"rows\": len(d)}\n",
    "            for m in SCORING:\n",
    "                s = scores[f\"test_{m}\"]\n",
    "                row[m] = f\"{100 * s.mean():.1f} ± {100 * s.std():.1f}\"\n",
    "            results.append(row)\n",
    "\n",
    "results_df = pd.DataFrame(results)\n",
