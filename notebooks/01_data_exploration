    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import shap\n",
    "import matplotlib.pyplot as plt\n",
    "from lime.lime_tabular import LimeTabularExplainer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report\n",
    "from imblearn.over_sampling import SMOTE\n",
    "\n",
    "os.makedirs(\"../results\", exist_ok=True)\n",
    "\n",
    "# ---------- 1. Data + 80/20 stratified split (duplicates hatake) ----------\n",
    "df = data[\"jm1\"].drop_duplicates()\n",
    "X = df.drop(columns=\"defects\")\n",
    "y = df[\"defects\"].astype(int)\n",
    "feature_names = X.columns.tolist()\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.2, stratify=y, random_state=42\n",
    ")\n",
    "\n",
    "# ---------- 2. Preprocess (fit sirf train pe) + SMOTE sirf train pe ----------\n",
    "imputer = SimpleImputer(strategy=\"median\").fit(X_train)\n",
    "scaler = MinMaxScaler().fit(imputer.transform(X_train))\n",
    "prep = lambda A: scaler.transform(imputer.transform(A))\n",
    "\n",
    "Xtr, Xte = prep(X_train), prep(X_test)\n",
    "Xtr_sm, ytr_sm = SMOTE(random_state=42).fit_resample(Xtr, y_train)\n",
    "\n",
    "# ---------- 3. Model ----------\n",
    "rf = RandomForestClassifier(n_estimators=200, random_state=42, n_jobs=-1).fit(Xtr_sm, ytr_sm)\n",
    "print(classification_report(y_test, rf.predict(Xte), digits=3))\n",
    "\n",
    "# ---------- 4. SHAP (global) ----------\n",
    "explainer = shap.TreeExplainer(rf)\n",
    "sv = explainer.shap_values(Xte)\n",
    "if isinstance(sv, list):\n",
    "    sv_pos = sv[1]\n",
    "elif sv.ndim == 3:\n",
    "    sv_pos = sv[:, :, 1]\n",
    "else:\n",
    "    sv_pos = sv\n",
    "\n",
    "shap_imp = pd.Series(np.abs(sv_pos).mean(axis=0), index=feature_names).sort_values(ascending=False)\n",
    "print(\"\\nTop 10 features (mean |SHAP|):\")\n",
    "print(shap_imp.head(10).round(4))\n",
    "\n",
    "shap.summary_plot(sv_pos, Xte, feature_names=feature_names, show=False)\n",
    "plt.savefig(\"../results/shap_summary_jm1.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "# ---------- 5. Ek module chuno: sabse confident true-positive ----------\n",
    "proba = rf.predict_proba(Xte)[:, 1]\n",
    "idx = int(np.argmax(proba * (y_test.values == 1)))\n",
    "print(f\"\\nChosen test module index: {idx} | predicted defect probability: {proba[idx]:.2f}\")\n",
    "\n",
    "# ---------- 6. SHAP (local) ----------\n",
    "loc_shap = pd.Series(sv_pos[idx], index=feature_names)\n",
    "top_local = loc_shap.reindex(loc_shap.abs().sort_values(ascending=False).index)[:8]\n",
    "print(\"\\nSHAP local contributions (top 8):\")\n",
    "print(top_local.round(4))\n",
    "\n",
    "plt.figure(figsize=(7, 4))\n",
    "top_local[::-1].plot(kind=\"barh\")\n",
    "plt.title(\"SHAP local explanation (one JM1 module)\")\n",
    "plt.xlabel(\"SHAP value (push towards defective if > 0)\")\n",
    "plt.savefig(\"../results/shap_local_jm1.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "# ---------- 7. LIME (same module) ----------\n",
    "lime_explainer = LimeTabularExplainer(\n",
    "    Xtr, feature_names=feature_names,\n",
    "    class_names=[\"non-defective\", \"defective\"],\n",
    "    mode=\"classification\", discretize_continuous=True, random_state=42,\n",
    ")\n",
    "exp = lime_explainer.explain_instance(Xte[idx], rf.predict_proba, num_features=8, num_samples=2000)\n",
    "print(\"\\nLIME explanation (top 8):\")\n",
    "print(pd.DataFrame(exp.as_list(), columns=[\"rule\", \"weight\"]).round(4))\n",
    "\n",
    "fig = exp.as_pyplot_figure()\n",
    "fig.savefig(\"../results/lime_local_jm1.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()"
